<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<appSettings>

		<!-- Tamaño máximo de canción: 50 MB -->
		<add key="maxSongLength" value="52428800"/>

		<!-- Carpetas de recursos -->
		<add key="albumImagePath" value="~/AlbumImages/"/>
		<add key="artistImagePath" value="~/ArtistImages/"/>
		<add key="userPhotoPath" value="~/UserImages/"/>
		<add key="songFolderPath" value="~/SongFiles/"/>
		<add key="playlistFolderPath" value="~/PlaylistImages/"/>

	</appSettings>

	<!-- Conexión a SQL Server -->
	<connectionStrings>

		<add
		  name="BDD_PoliMusicConnectionString"
		  connectionString="Data Source=localhost;Initial Catalog=BDD_PoliMusic;User ID=usr_polimusic;Password=Politecnica1"
		  providerName="System.Data.SqlClient"/>

	</connectionStrings>

	<system.web>

		<compilation debug="true"/>

		<!-- Tamaño máximo de carga: 50 MB -->
		<httpRuntime maxRequestLength="51200"/>

		<!-- Autenticación de usuarios -->
		<authentication mode="Forms">
			<forms
			  loginUrl="Login.aspx"
			  defaultUrl="Default.aspx"
			  timeout="20"/>
		</authentication>

		<!-- Restringir acceso a usuarios no autenticados -->
		<authorization>
			<deny users="?"/>
		</authorization>

		<pages/>

	</system.web>

	<!-- Permitir el registro de usuarios -->
	<location path="SignUp.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- Configuración para archivos de música -->
	<location path="SongFiles">
		<system.web>
			<httpRuntime maxRequestLength="51200"/>
		</system.web>
	</location>

	<system.webServer>

		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="52428800"/>
			</requestFiltering>
		</security>

	</system.webServer>

</configuration>
